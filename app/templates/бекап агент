function editMemoryItem(btn){
  const textEl=btn.closest('.memory-item').querySelector('.text');
  if(textEl.contentEditable==='true'){
    // Save
    textEl.contentEditable='false';
    const item=textEl.closest('.memory-item');
    const key=item.dataset.key;
    const idx=parseInt(item.dataset.idx);
    updateMemoryItem(key,idx,textEl.textContent);
  }else{
    textEl.contentEditable='true';
    textEl.focus();
  }
}

