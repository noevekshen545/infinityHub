function formatText(t){if(!t)return'';let h=esc(t);h=h.replace(/```(\w+)?\n([\s\S]*?)```/g,'<pre><code>$2</code><button class="copy-btn" onclick="copyCode(this)"><i class="fas fa-copy"></i></button></pre>');h=h.replace(/`([^`]+)`/g,'<code>$1</code>');h=h.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');return h}
function esc(t){if(!t)return'';const d=document.createElement('div');d.textContent=t;return d.innerHTML}
function copyCode(btn){navigator.clipboard.writeText(btn.parentElement.querySelector('code').textContent);btn.innerHTML='<i class="fas fa-check"></i>';setTimeout(()=>btn.innerHTML='<i class="fas fa-copy"></i>',1500)}

