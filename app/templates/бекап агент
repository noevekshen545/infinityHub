    html += `<div style="padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-top:12px">
      <div style="font-size:12px;color:var(--text);font-weight:600;margin-bottom:8px">🧠 Модель для снов</div>
      <select id="dreamsModel" onchange="saveDreamsModel(this.value)" style="width:100%;padding:8px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:11px">
        <option value="gemma-3-4b-it">gemma-3-4b-it (быстрая)</option>
        <option value="gemma-4-e2b-it">gemma-4-e2b-it (средняя)</option>
        <option value="qwen/qwen3.5-9b">qwen3.5-9b (качественная)</option>
      </select>
    </div>`;

    body.innerHTML = html;

    // Load saved model
    try{
      const mr = await fetch('/api/agent/dreams/settings');
      const md = await mr.json();
      if(md.success && md.dreams_model){
        const sel = document.getElementById('dreamsModel');
        if(sel) sel.value = md.dreams_model;
      }
    }catch(e){}
  }catch(e){
    body.innerHTML = `<div style="padding:20px;color:var(--red);font-size:12px;text-align:center">❌ ${e.message}</div>`;
  }
}

async function saveDreamsModel(model){
  try{
    await fetch('/api/agent/dreams/model',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model})});
    showTempNotification('🧠 Модель для снов: '+model);
  }catch(e){console.error(e)}
}

async function toggleDreamsMode(enabled){
  try{
    const r = await fetch('/api/agent/dreams/toggle', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({enabled})
    });
    const d = await r.json();
    if(d.success){
      const btn = document.getElementById('dreamsBtn');
      if(btn){
        btn.style.opacity = enabled ? '1' : '0.4';
        btn.title = enabled ? 'Сны включены' : 'Сны отключены';
      }
      showTempNotification(d.message);
    } else {
      showTempNotification('❌ Ошибка: ' + (d.error || 'Неизвестная'));
    }
  }catch(e){
    console.error('Toggle dreams error:', e);
    showTempNotification('❌ Ошибка сети: ' + e.message);
  }
}

async function enterDreamsNow(){
  showTempNotification('💤 Агент входит в сон...');
  try{
    const r = await fetch('/api/agent/dreams/enter', {method: 'POST'});
    const d = await r.json();
    if(d.status === 'dreaming_started'){
