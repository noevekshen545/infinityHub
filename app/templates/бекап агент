<!DOCTYPE html>
<html lang="ru"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ASIO Agent</title>
<link rel="stylesheet" href="/static/css/font-awesome.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
:root{--bg:#0d1117;--bg2:#161b22;--bg3:#21262d;--border:#30363d;--text:#c9d1d9;--text2:#8b949e;--text3:#484f58;--accent:#58a6ff;--accent2:#1f6feb;--green:#238636;--red:#da3633;--purple:#8b5cf6;--orange:#f97316;--gradient:linear-gradient(135deg,#58a6ff,#8b5cf6)}
body.light{--bg:#ffffff;--bg2:#f6f8fa;--bg3:#f0f3f6;--border:#d0d7de;--text:#1f2328;--text2:#656d76;--text3:#8b949e;--accent:#0969da;--accent2:#0969da;--green:#1a7f37;--red:#cf222e;--purple:#7c3aed;--orange:#ea580c;--gradient:linear-gradient(135deg,#0969da,#7c3aed)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;transition:background .3s,color .3s}
a{color:var(--accent);text-decoration:none}

.topnav{background:var(--bg2);border-bottom:1px solid var(--border);padding:10px 20px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100}
.topnav .logo{font-size:18px;font-weight:700;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-right:8px;white-space:nowrap}
.topnav .nav-links{display:flex;gap:6px;flex:1;flex-wrap:wrap}
.topnav .nav-link{padding:6px 12px;border-radius:8px;color:var(--text2);font-size:12px;transition:all .2s;display:flex;align-items:center;gap:5px;white-space:nowrap}
.topnav .nav-link:hover{background:var(--bg3);color:var(--text)}
.topnav .actions{display:flex;gap:6px;align-items:center}
.topnav .icon-btn{background:var(--bg);border:1px solid var(--border);color:var(--text);width:34px;height:34px;border-radius:8px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all .2s;text-decoration:none}
.topnav .icon-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

.main{flex:1;display:flex;gap:0;overflow:hidden;height:calc(100vh - 52px)}
.sidebar{width:280px;background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden}
.sidebar-header{padding:14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:6px;flex-shrink:0}
.sidebar-header h3{font-size:13px;color:var(--text);margin:0}
.sidebar-header button{padding:6px 10px;background:var(--accent);border:none;border-radius:6px;color:#fff;cursor:pointer;font-size:11px;font-weight:600;display:flex;align-items:center;gap:4px}
.sidebar-header button:hover{opacity:.85}
.sidebar-header button.del{background:var(--red)}
.sidebar-content{flex:1;overflow-y:auto;padding:8px;min-height:0}
.sidebar .new-btn{padding:10px;background:var(--accent);border:none;border-radius:8px;color:#fff;cursor:pointer;font-size:12px;font-weight:600}

.content{flex:1;display:flex;flex-direction:column;overflow:hidden}

/* Config Bar */
.config-bar{background:var(--bg2);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.config-bar label{font-size:11px;color:var(--text2);font-weight:600}
.config-bar select,.config-bar input{background:var(--bg);border:1px solid var(--border);color:var(--text);padding:6px 10px;border-radius:6px;font-size:12px;outline:none}
.config-bar select:focus{border-color:var(--accent)}
.mode-tabs{display:flex;gap:4px}
.mode-tab{padding:8px 14px;border-radius:8px;cursor:pointer;font-size:12px;font-weight:600;border:1px solid var(--border);background:var(--bg);color:var(--text2);transition:all .2s;display:flex;align-items:center;gap:5px}
.mode-tab:hover{border-color:var(--accent)}
.mode-tab.active{background:var(--gradient);border-color:transparent;color:#fff}
.exec-mode{padding:4px 10px;border-radius:12px;font-size:10px;font-weight:700;text-transform:uppercase}
.exec-mode.advisory{background:var(--orange);color:#fff}
.exec-mode.autonomy{background:var(--green);color:#fff}

/* Folder Picker */
.folder-picker{display:none;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px;margin-top:8px;width:100%}
.folder-picker.open{display:block}
.folder-picker h4{font-size:12px;color:var(--text);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.folder-picker .folder-list{max-height:150px;overflow-y:auto}
.folder-picker .folder-item{padding:8px 10px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:6px;font-size:12px;transition:all .15s}
.folder-picker .folder-item:hover{background:var(--bg3)}
.folder-picker .folder-item.selected{background:var(--accent);color:#fff}

/* Chat */
.chat-box{flex:1;overflow-y:auto;padding:16px;min-height:0}
.chat-box::-webkit-scrollbar{width:6px}
.chat-box::-webkit-scrollbar-track{background:transparent}
.chat-box::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.chat-box::-webkit-scrollbar-thumb:hover{background:var(--text3)}
.msg{margin-bottom:16px;max-width:95%;position:relative}
.msg.user{margin-left:auto}
.msg.ai{margin-right:auto}
.msg-bubble{padding:14px 18px;border-radius:14px;line-height:1.6;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.msg.user .msg-bubble{background:var(--gradient);color:#fff;border-bottom-right-radius:4px}
.msg.ai .msg-bubble{background:var(--bg2);border:1px solid var(--border);border-bottom-left-radius:4px}
.msg .label{font-weight:600;font-size:11px;margin-bottom:6px;opacity:.8;display:flex;align-items:center;gap:6px}
.msg .text{font-size:13px;white-space:pre-wrap;word-wrap:break-word}
.msg .text code{background:var(--bg3);padding:1px 5px;border-radius:3px;font-family:'Fira Code',monospace;font-size:12px}
.msg .text pre{background:var(--bg);padding:10px;border-radius:6px;overflow-x:auto;margin:8px 0;font-family:'Fira Code',monospace;font-size:12px;line-height:1.5;position:relative;border:1px solid var(--border)}
.msg .text pre code{background:none;padding:0}

/* Action Steps */
.action-steps{margin:10px 0}
.action-step{display:flex;gap:8px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--border)}
.action-step:last-child{border-bottom:none}
.step-icon{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;flex-shrink:0}
.step-icon.analysis{background:var(--purple);color:#fff}
.step-icon.plan{background:var(--accent);color:#fff}
.step-icon.memory{background:var(--green);color:#fff}
.step-icon.code{background:var(--orange);color:#fff}
.step-icon.exec{background:var(--green);color:#fff}
.step-icon.error{background:var(--red);color:#fff}
.step-icon.result{background:var(--accent2);color:#fff}
.step-icon.spawn{background:var(--purple);color:#fff}
.step-icon.tool{background:var(--orange);color:#fff}
.step-content{flex:1;min-width:0}
.step-content .step-title{font-size:11px;font-weight:700;color:var(--text);text-transform:uppercase;margin-bottom:2px}
.step-content .step-text{font-size:12px;color:var(--text2);white-space:pre-wrap;word-break:break-word}

/* Code Execution Panel */
.code-panel{background:var(--bg);border:1px solid var(--border);border-radius:10px;margin:10px 0;overflow:hidden}
.code-panel .header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--bg3);border-bottom:1px solid var(--border)}
.code-panel .lang{font-size:11px;color:var(--accent);font-weight:700;text-transform:uppercase}
.code-panel .status{font-size:10px;padding:3px 8px;border-radius:10px;font-weight:600}
.code-panel .status.pending{background:var(--bg);color:var(--text2)}
.code-panel .status.running{background:var(--orange);color:#fff}
.code-panel .status.success{background:var(--green);color:#fff}
.code-panel .status.error{background:var(--red);color:#fff}
.code-panel .status.advisory{background:var(--purple);color:#fff}
.code-panel pre{padding:10px;overflow-x:auto;font-family:'Fira Code',monospace;font-size:12px;line-height:1.5;max-height:300px;overflow-y:auto}
.code-panel .output{padding:10px;background:var(--bg2);border-top:1px solid var(--border);font-family:'Fira Code',monospace;font-size:12px;white-space:pre-wrap;max-height:200px;overflow-y:auto}
.code-panel .actions{padding:8px 12px;border-top:1px solid var(--border);display:flex;gap:6px}
.code-panel .actions button{padding:6px 12px;border-radius:6px;cursor:pointer;font-size:11px;font-weight:600;border:1px solid var(--border);background:var(--bg);color:var(--text);transition:all .2s}
.code-panel .actions button:hover{border-color:var(--accent)}
.code-panel .actions button.execute{background:var(--green);border-color:var(--green);color:#fff}
.code-panel .actions button.execute:hover{opacity:.85}
.code-panel .actions button.skip{background:var(--red);border-color:var(--red);color:#fff}

/* Sub-Agent */
.subagent-badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:600;background:var(--purple);color:#fff;margin-bottom:4px}

/* Welcome */
.welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px 20px;text-align:center}
.welcome .icon{font-size:64px;margin-bottom:16px;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.welcome h2{font-size:24px;font-weight:700;margin-bottom:8px;background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.welcome p{font-size:13px;color:var(--text2);max-width:500px;margin-bottom:16px}
.welcome .capabilities{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;max-width:700px;width:100%;margin-top:20px}
.welcome .cap{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:left}
.welcome .cap .ci{font-size:20px;margin-bottom:6px}
.welcome .cap h4{font-size:12px;color:var(--text);margin-bottom:3px}
.welcome .cap p{font-size:11px;color:var(--text2);margin:0}

/* Input */
.input-area{padding:14px 16px;border-top:1px solid var(--border);background:var(--bg2)}
.input-row{display:flex;gap:8px;align-items:flex-end}
.input-row textarea{flex:1;padding:12px 14px;background:var(--bg);border:2px solid var(--border);border-radius:12px;color:var(--text);font-size:13px;resize:none;outline:none;font-family:inherit;min-height:44px;max-height:120px;transition:border-color .2s}
.input-row textarea:focus{border-color:var(--accent)}
.input-row .send{width:44px;height:44px;background:var(--gradient);border:none;border-radius:12px;color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
.input-row .send:hover{transform:scale(1.05)}
.input-row .send:disabled{opacity:.4;transform:none}
.input-hint{font-size:10px;color:var(--text3);margin-top:6px;text-align:center}

/* Session */
.session-item{padding:10px;border-radius:8px;cursor:pointer;margin-bottom:4px;transition:all .15s;border:1px solid transparent}
.session-item:hover{background:var(--bg3)}
.session-item.active{background:var(--bg3);border-color:var(--accent)}
.session-item .title{font-size:12px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.session-item .preview{font-size:10px;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}

/* Loading */
.loading{display:flex;align-items:center;gap:10px;padding:12px;color:var(--text2);font-size:12px}
.loading .spinner{width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* Cancel & Reason Buttons */
.action-buttons-row{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.action-btn{padding:6px 14px;border-radius:8px;cursor:pointer;font-size:11px;font-weight:600;border:1px solid var(--border);background:var(--bg);color:var(--text);transition:all .2s;display:flex;align-items:center;gap:5px}
.action-btn:hover{border-color:var(--accent);background:var(--bg3)}
.action-btn.cancel{border-color:var(--red);color:var(--red)}
.action-btn.cancel:hover{background:var(--red);color:#fff}
.action-btn.reason{border-color:var(--purple);color:var(--purple)}
.action-btn.reason:hover{background:var(--purple);color:#fff}
.action-btn.skill{border-color:var(--orange);color:var(--orange)}
.action-btn.skill:hover{background:var(--orange);color:#fff}
.action-btn:disabled{opacity:0.4;cursor:not-allowed}

/* Glassmorphism */
.glass{background:rgba(22,27,34,0.7);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(48,54,61,0.5)}
.glass-card{background:rgba(22,27,34,0.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(88,166,255,0.15);border-radius:12px;padding:16px;transition:all .3s}
.glass-card:hover{border-color:rgba(88,166,255,0.4);box-shadow:0 4px 20px rgba(88,166,255,0.1)}
.glass-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;font-size:10px;font-weight:600;background:rgba(88,166,255,0.15);border:1px solid rgba(88,166,255,0.3);color:var(--accent)}

/* Reasoning Panel */
.reasoning-box{background:var(--bg);border:1px solid var(--purple);border-radius:10px;margin:10px 0;overflow:hidden}
.reasoning-box .header{padding:8px 12px;background:linear-gradient(135deg,rgba(139,92,246,0.1),rgba(88,166,255,0.1));border-bottom:1px solid var(--purple);display:flex;align-items:center;justify-content:space-between}
.reasoning-box .header .title{font-size:12px;font-weight:700;color:var(--purple);display:flex;align-items:center;gap:6px}
.reasoning-box .content{padding:12px;font-size:12px;color:var(--text2);white-space:pre-wrap;line-height:1.6;max-height:400px;overflow-y:auto}

/* Skill Creation Badge */
.skill-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;font-size:10px;font-weight:600;background:linear-gradient(135deg,var(--orange),var(--purple));color:#fff}

/* Knowledge Graph Badge
.kg-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:12px;font-size:10px;font-weight:600;background:linear-gradient(135deg,var(--green),var(--accent));color:#fff}

/* Progress Bar for tasks */
.task-progress{height:3px;background:var(--bg3);border-radius:2px;margin:8px 0;overflow:hidden}
.task-progress .bar{height:100%;background:var(--gradient);border-radius:2px;transition:width .3s}

/* Scheduler Status */
.scheduler-status{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--bg);border-radius:8px;margin:8px 0;font-size:11px}
.scheduler-status .dot{width:8px;height:8px;border-radius:50%}
.scheduler-status .dot.thinking{background:var(--purple);animation:pulse 1.5s infinite}
.scheduler-status .dot.executing{background:var(--orange);animation:pulse 1s infinite}
.scheduler-status .dot.completed{background:var(--green)}
.scheduler-status .dot.cancelled{background:var(--red)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.3}}

/* Reasoning Iteration Counter */
.reasoning-counter{font-size:10px;color:var(--purple);font-weight:600;padding:2px 8px;background:rgba(139,92,246,0.1);border-radius:10px}

.copy-btn{position:absolute;top:6px;right:6px;padding:4px 8px;background:var(--bg3);border:1px solid var(--border);border-radius:4px;color:var(--text2);cursor:pointer;font-size:10px;opacity:0;transition:opacity .2s}
pre:hover .copy-btn{opacity:1}

@media(max-width:768px){
  .sidebar{width:100%;max-height:250px;border-right:none;border-bottom:1px solid var(--border)}
  .main{flex-direction:column}
  .topnav .nav-links{display:none}
}

/* Side Panels */
.side-panel{position:fixed;top:0;right:-450px;width:450px;height:100vh;background:var(--bg2);border-left:1px solid var(--border);z-index:200;transition:right .3s;overflow-y:auto;display:flex;flex-direction:column}
.side-panel.open{right:0}
.side-panel .panel-header{padding:16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;background:var(--bg2);z-index:1}
.side-panel .panel-header h3{font-size:16px;color:var(--text);margin:0;display:flex;align-items:center;gap:8px}
.side-panel .close-btn{background:none;border:none;color:var(--text2);font-size:20px;cursor:pointer}
.side-panel .panel-body{flex:1;padding:16px;overflow-y:auto}

/* Memory Panel */
.memory-section{margin-bottom:16px}
.memory-section h4{font-size:13px;color:var(--text);margin-bottom:8px;display:flex;align-items:center;justify-content:space-between}
.memory-section h4 button{padding:4px 8px;border-radius:4px;cursor:pointer;font-size:10px;border:1px solid var(--border);background:var(--bg);color:var(--text2)}
.memory-section h4 button:hover{border-color:var(--accent)}
.memory-item{padding:10px;background:var(--bg);border:1px solid var(--border);border-radius:8px;margin-bottom:6px;position:relative}
.memory-item .text{font-size:12px;color:var(--text);white-space:pre-wrap;word-break:break-word}
.memory-item .text[contenteditable="true"]{outline:1px solid var(--accent);padding:4px}
.memory-item .meta{font-size:10px;color:var(--text3);margin-top:4px}
.memory-item .actions{position:absolute;top:6px;right:6px;display:flex;gap:4px;opacity:0;transition:opacity .2s}
.memory-item:hover .actions{opacity:1}
.memory-item .actions button{padding:3px 6px;border-radius:4px;cursor:pointer;font-size:10px;border:1px solid var(--border);background:var(--bg3);color:var(--text2)}
.memory-item .actions button:hover{border-color:var(--accent)}
.memory-item .actions button.del:hover{border-color:var(--red);color:var(--red)}

/* Tools Panel */
.tool-item{padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:8px;margin-bottom:8px}

/* Dreams Panel */
.dream-item.expanded .dream-details{display:block !important}
.dream-item:hover{border-color:var(--accent) !important}

/* Toggle Switch */
.switch{position:relative;display:inline-block;width:44px;height:24px}
.switch input{opacity:0;width:0;height:0}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:var(--bg3);border:1px solid var(--border);border-radius:24px;transition:.3s}
.slider:before{position:absolute;content:"";height:18px;width:18px;left:2px;bottom:2px;background:var(--text2);border-radius:50%;transition:.3s}
input:checked+.slider{background:var(--accent);border-color:var(--accent)}
input:checked+.slider:before{transform:translateX(20px);background:#fff}
.tool-item .name{font-size:13px;font-weight:600;color:var(--accent)}
.tool-item .desc{font-size:11px;color:var(--text2);margin-top:4px}
.tool-item .path{font-size:10px;color:var(--text3);margin-top:2px;font-family:monospace}
.tool-item .actions{margin-top:8px;display:flex;gap:4px}
.tool-item .actions button{padding:4px 10px;border-radius:6px;cursor:pointer;font-size:10px;border:1px solid var(--border);background:var(--bg3);color:var(--text2)}
.tool-item .actions button:hover{border-color:var(--accent)}
.tool-item .actions button.del:hover{border-color:var(--red);color:var(--red)}
.import-zone{margin-top:12px;padding:12px;background:var(--bg);border:2px dashed var(--border);border-radius:8px;text-align:center}
.import-zone textarea{width:100%;min-height:80px;background:var(--bg2);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:8px;font-size:12px;font-family:monospace;resize:vertical;margin-top:8px}
.import-zone button{margin-top:8px;padding:6px 16px;border-radius:6px;cursor:pointer;font-size:12px;border:1px solid var(--accent);background:var(--accent);color:#fff}

.overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:199}
.overlay.open{display:block}
</style></head><body>

<div class="topnav">
  <div class="logo">🤖 ASIO Agent</div>
  <div class="nav-links">
    <a class="nav-link" href="/ask"><i class="fas fa-comments"></i> AI Чат</a>
    <a class="nav-link" href="/notes"><i class="fas fa-sticky-note"></i> Заметки</a>
    <a class="nav-link" href="/books"><i class="fas fa-book"></i> Книги</a>
    <a class="nav-link" href="/zim"><i class="fas fa-book-open"></i> ZIM</a>
    <a class="nav-link" href="/api/agent/team"><i class="fas fa-users"></i> Команды</a>
    <a class="nav-link" href="/api/agent/analytics"><i class="fas fa-chart-bar"></i> Аналитика</a>
    <a class="nav-link" href="/api/agent/memory-graph"><i class="fas fa-project-diagram"></i> Граф</a>
    <a class="nav-link" href="/api/agent/plugins-marketplace"><i class="fas fa-puzzle-piece"></i> Плагины</a>
    <a class="nav-link" href="/api/agent/server-settings"><i class="fas fa-cog"></i> Настройки</a>
    <a class="nav-link" href="/"><i class="fas fa-home"></i> Главная</a>
  </div>
  <div class="actions">
