// === QUICK SWITCH PROVIDER ===
async function quickSwitchProvider(type){
  const localBtn=document.getElementById('toggleLocalBtn');
  const cloudBtn=document.getElementById('toggleCloudBtn');
  const toggle=document.getElementById('providerToggle');

  // Анимация переключения
  if(type==='local'){
    localBtn.style.background='var(--green)';
    localBtn.style.color='#fff';
    localBtn.style.boxShadow='0 0 12px var(--green)';
    cloudBtn.style.background='transparent';
    cloudBtn.style.color='var(--text2)';
    cloudBtn.style.boxShadow='none';
    toggle.style.borderColor='var(--green)';
  }else{
    cloudBtn.style.background='var(--accent)';
    cloudBtn.style.color='#fff';
    cloudBtn.style.boxShadow='0 0 12px var(--accent)';
    localBtn.style.background='transparent';
    localBtn.style.color='var(--text2)';
    localBtn.style.boxShadow='none';
    toggle.style.borderColor='var(--accent)';
  }

  // Сохраняем в конфиг
  try{
    const r=await fetch('/api/agent/provider/config',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({type})
    });
    const d=await r.json();

    if(d.ok){
      // Показываем уведомление
      const msg=type==='local'?'🏠 Локальная модель активна':'🌐 Облачный API активен';
      showTempNotification(msg);

      // Обновляем панель провайдера если открыта
      selectProviderType(type);
    }
  }catch(e){
    console.error('Provider switch error:',e);
  }
}

function showTempNotification(msg){
  // Создаём временное уведомление
  const div=document.createElement('div');
  div.style.cssText=`
    position:fixed;top:20px;right:20px;padding:12px 20px;
    background:var(--green);color:#fff;border-radius:10px;
    font-size:13px;font-weight:600;z-index:9999;
    animation:slideIn .3s ease;box-shadow:0 4px 12px rgba(0,0,0,.3);
  `;
  div.textContent=msg;
  document.body.appendChild(div);

  setTimeout(()=>{
    div.style.animation='slideOut .3s ease';
    setTimeout(()=>div.remove(),300);
  },2000);
}

// Добавляем CSS анимации
const style=document.createElement('style');
style.textContent=`
  @keyframes slideIn{from{transform:translateX(100px);opacity:0}to{transform:translateX(0);opacity:1}}
  @keyframes slideOut{from{transform:translateX(0);opacity:1}to{transform:translateX(100px);opacity:0}}
`;
document.head.appendChild(style);

// === PROVIDER PANEL FUNCTIONS ===
async function loadProviderConfig(){
  try{
    const r=await fetch('/api/agent/provider/config');
    const d=await r.json();

    // Set provider type
    const type=d.type||'local';

    // Обновляем toggle кнопки
    quickSwitchProvider(type);

    // Fill local provider settings
    if(d.local){
      document.getElementById('localUrl').value=d.local.url||'http://localhost:1234';
      document.getElementById('localModel').value=d.local.model||'';
      document.getElementById('localApiKey').value=d.local.api_key||'';
    }

    // Fill cloud provider settings
    if(d.openai_compatible){
      document.getElementById('cloudBaseUrl').value=d.openai_compatible.base_url||'';
      // НЕ показываем "***" - показываем пустое поле или реальный ключ если есть в конфиге
      const apiKey=d.openai_compatible.api_key;
      if(apiKey && apiKey!=='***'){
        document.getElementById('cloudApiKey').value=apiKey;
      }else{
        // Проверяем есть ли ключ в config.json напрямую
        document.getElementById('cloudApiKey').value='';
      }
      document.getElementById('cloudModel').value=d.openai_compatible.model||'';
      document.getElementById('cloudTemperature').value=d.openai_compatible.temperature||0.7;
      document.getElementById('cloudMaxTokens').value=d.openai_compatible.max_tokens||8192;
      document.getElementById('cloudReasoning').checked=d.openai_compatible.reasoning_enabled||false;
    }

    // Update status
    updateProviderStatus(type);
  }catch(e){console.error('Load provider config error:',e)}
}

function selectProviderType(type){
  const localBtn=document.getElementById('btnLocalProvider');
  const cloudBtn=document.getElementById('btnCloudProvider');
  const localSettings=document.getElementById('localProviderSettings');
  const cloudSettings=document.getElementById('cloudProviderSettings');

  if(type==='local'){
    localBtn.style.borderColor='var(--accent)';
    localBtn.style.background='var(--accent)';
    localBtn.style.color='#fff';
    cloudBtn.style.borderColor='var(--border)';
    cloudBtn.style.background='var(--bg)';
    cloudBtn.style.color='var(--text)';
    localSettings.style.display='block';
    cloudSettings.style.display='none';
  }else{
    cloudBtn.style.borderColor='var(--accent)';
    cloudBtn.style.background='var(--accent)';
    cloudBtn.style.color='#fff';
    localBtn.style.borderColor='var(--border)';
    localBtn.style.background='var(--bg)';
    localBtn.style.color='var(--text)';
    cloudSettings.style.display='block';
    localSettings.style.display='none';
  }
}

async function saveProviderConfig(){
  const isLocal=document.getElementById('localProviderSettings').style.display!=='none';
  const type=isLocal?'local':'openai_compatible';

  const data={type};

  if(isLocal){
    data.url=document.getElementById('localUrl').value;
    data.model=document.getElementById('localModel').value;
    data.api_key=document.getElementById('localApiKey').value;
  }else{
    data.base_url=document.getElementById('cloudBaseUrl').value;
    // ВСЕГДА отправляем API ключ из поля (пользователь ввёл его вручную или он загрузился)
    const apiKey=document.getElementById('cloudApiKey').value;
    if(apiKey && apiKey.trim() && apiKey.trim() !== '***'){
      data.api_key=apiKey.trim();
    }
    data.model=document.getElementById('cloudModel').value;
    data.temperature=parseFloat(document.getElementById('cloudTemperature').value);
    data.max_tokens=parseInt(document.getElementById('cloudMaxTokens').value);
    data.reasoning_enabled=document.getElementById('cloudReasoning').checked;

    // Проверка что все поля заполнены
    if(!data.base_url || !data.api_key || !data.model){
      alert('⚠️ Заполните все поля: Base URL, API Key и Model');
      return;
    }
  }

  try{
    const r=await fetch('/api/agent/provider/config',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(data)
    });
    const d=await r.json();
    if(d.ok){
      alert('✅ Конфигурация провайдера сохранена!');
      updateProviderStatus(type);
      // Обновляем toggle кнопки
      quickSwitchProvider(type);
    }else{
      alert('❌ Ошибка: '+JSON.stringify(d));
    }
  }catch(e){
    alert('❌ Ошибка сохранения: '+e.message);
  }
}

async function testProviderConnection(){
  const btn=document.getElementById('testProviderBtn');
  const result=document.getElementById('testProviderResult');

  btn.disabled=true;
  btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Тестирование...';
  result.innerHTML='';

  try{
    const r=await fetch('/api/agent/provider/test',{method:'POST'});
    const d=await r.json();

    if(d.success){
      result.innerHTML=`<span style="color:var(--green)">✅ Подключение успешно!</span>`;
      if(d.provider){
        result.innerHTML+=`<br><span style="font-size:10px;color:var(--text3)">${d.provider} | ${d.base_url||''} | ${d.model||''}</span>`;
      }
      if(d.response){
        result.innerHTML+=`<br><span style="font-size:10px;color:var(--text2)">"${d.response}"</span>`;
      }
    }else{
      result.innerHTML=`<span style="color:var(--red)">❌ Ошибка: ${d.error}</span>`;
    }
  }catch(e){
    result.innerHTML=`<span style="color:var(--red)">❌ Ошибка: ${e.message}</span>`;
  }

  btn.disabled=false;
  btn.innerHTML='<i class="fas fa-plug"></i> Тест подключения';
}

function showProviderPanel(){
  document.getElementById('providerPanel').classList.add('open');
  document.getElementById('memOverlay').classList.add('open');
  loadProviderConfig();
}

function updateProviderStatus(type){
  const status=document.getElementById('providerStatus');
  if(type==='local'){
    status.innerHTML=`🏠 <b>Локальные модели</b><br><span style="font-size:9px">LM Studio | http://localhost:1234</span>`;
  }else{
    status.innerHTML=`🌐 <b>Облачный API</b><br><span style="font-size:9px">OpenAI Compatible</span>`;
  }
}
