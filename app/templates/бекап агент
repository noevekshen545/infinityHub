// State
let currentMode='general', currentSession=null, sessions=[], selectedFolder=null, processing=false;
let config=JSON.parse(localStorage.getItem('asio_config')||'{}');

// Theme
function getTheme(){return localStorage.getItem('infinity_theme')||'dark'}
function setTheme(t){document.body.className=t==='light'?'light':'';document.getElementById('themeBtn').innerHTML=t==='light'?'<i class="fas fa-sun"></i>':'<i class="fas fa-moon"></i>';localStorage.setItem('infinity_theme',t)}
function toggleTheme(){setTheme(getTheme()==='dark'?'light':'dark')}
setTheme(getTheme());

function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,120)+'px'}

// Config
function updateMaxIterInputVisibility() {
    const sel = document.getElementById('maxIter');
    const customInput = document.getElementById('maxIterCustom');
    customInput.style.display = sel.value === 'custom' ? 'inline-block' : 'none';
}

function getEffectiveMaxIterations() {
    const sel = document.getElementById('maxIter');
    if (sel.value === 'custom') {
        return parseInt(document.getElementById('maxIterCustom').value) || 50;
    }
    return parseInt(sel.value) || 0;
}

function saveConfig(){config.model=document.getElementById('modelSelect').value;config.execMode=document.getElementById('execMode').value;config.mode=currentMode;config.folder=selectedFolder;config.maxIter=document.getElementById('maxIter').value;config.maxIterCustom=document.getElementById('maxIterCustom').value;localStorage.setItem('asio_config',JSON.stringify(config))}
function loadConfig(){
  if(config.model)document.getElementById('modelSelect').value=config.model;
  if(config.execMode)document.getElementById('execMode').value=config.execMode;
  if(config.maxIter!==undefined)document.getElementById('maxIter').value=config.maxIter;
  if(config.maxIterCustom!==undefined)document.getElementById('maxIterCustom').value=config.maxIterCustom;
  updateMaxIterInputVisibility();
  if(config.mode)setMode(config.mode);
  if(config.folder){selectedFolder=config.folder}
  updateModelDisplay();
}
function updateModelDisplay(){
  const m=document.getElementById('modelSelect').value;
  document.getElementById('modelDisplay').textContent='🤖 '+m;
}

// Load models
async function loadModels(){
  try{
    const r=await fetch('/api/agent/models');
    const d=await r.json();
    const sel=document.getElementById('modelSelect');
    if(d.models&&d.models.length){
      sel.innerHTML=d.models.map(m=>`<option value="${m}">${m}</option>`).join('');
    }
    if(config.model&&d.models.includes(config.model))sel.value=config.model;
    else if(d.defaultModel)sel.value=d.defaultModel;
  }catch(e){console.error('loadModels:',e)}
}

// Mode
function setMode(m){
  currentMode=m;
  document.querySelectorAll('.mode-tab').forEach(t=>t.classList.remove('active'));
  document.querySelector(`.mode-tab[data-mode="${m}"]`).classList.add('active');
  // Always show folder picker in both modes
  document.getElementById('folderPicker').classList.add('open');
  if(!selectedFolder)refreshFolders();
  saveConfig();
}

// Folders
async function refreshFolders(){
  try{
    const r=await fetch('/api/agent/folders');
    const d=await r.json();
    document.getElementById('folderList').innerHTML=(d.folders||[]).map(f=>
      `<div class="folder-item ${f.path===selectedFolder?'selected':''}" onclick="selectFolder('${f.path.replace(/'/g,"\\'")}')"><i class="fas fa-folder"></i><span>${f.name}</span><span style="margin-left:auto;font-size:10px;color:var(--text3)">${f.path}</span></div>`
    ).join('');
  }catch(e){console.error(e)}
}
function selectFolder(p){selectedFolder=p;document.querySelectorAll('.folder-item').forEach(f=>f.classList.remove('selected'));event.currentTarget.classList.add('selected');saveConfig()}

function selectCustomFolder(){
  const path=document.getElementById('customFolderPath').value.trim();
  if(!path){alert('Введите путь');return}
  selectedFolder=path;
  document.querySelectorAll('.folder-item').forEach(f=>f.classList.remove('selected'));
  saveConfig();
  showTempNotification('✅ Выбрана папка: '+path);
}

function selectHomeFolder(){
  selectedFolder='/home/infinity';
  document.getElementById('customFolderPath').value='/home/infinity';
  document.querySelectorAll('.folder-item').forEach(f=>f.classList.remove('selected'));
  saveConfig();
  showTempNotification('✅ Выбрана домашняя папка: /home/infinity');
}

// Ask DB Toggle
let askDbEnabled = false;

function toggleAskDb(enabled){
  askDbEnabled = enabled;
  document.getElementById('askDbStatus').textContent = enabled ? '✅ Включено' : 'Выключено';
  document.getElementById('askDbStatus').style.color = enabled ? 'var(--green)' : 'var(--text3)';
  saveConfig();
  showTempNotification(enabled ? '🗄️ Ask DB включено — агент будет использовать базу знаний' : 'Ask DB выключено');
}

// Sessions
async function loadSessions(){
  try{
    const r=await fetch('/api/agent/sessions');
    const d=await r.json();
    sessions=d.sessions||[];
    const el=document.getElementById('sessionList');
    if(!sessions.length){el.innerHTML='<div style="padding:30px 16px;text-align:center;color:var(--text3);font-size:12px">Нет сессий</div>';return}
    el.innerHTML=sessions.map(s=>`<div class="session-item ${s.id===currentSession?'active':''}">
      <div style="display:flex;align-items:center;gap:4px" onclick="switchSession('${s.id}')">
        <div style="flex:1;min-width:0">
          <div class="title">${esc((s.title||'Сессия').substring(0,35))}</div>
          <div class="preview">${esc((s.preview||'').substring(0,50))}</div>
        </div>
      </div>
      <button onclick="event.stopPropagation();deleteSession('${s.id}')" style="float:right;padding:2px 6px;background:none;border:none;color:var(--text3);cursor:pointer;font-size:11px;border-radius:4px" title="Удалить"><i class="fas fa-times"></i></button>
    </div>`).join('');
  }catch(e){console.error(e)}
}

async function deleteSession(id){
  if(!confirm('Удалить сессию?'))return;
  try{
    await fetch(`/api/agent/sessions/${id}`,{method:'DELETE'});
    if(currentSession===id){currentSession=null;document.getElementById('messagesContainer').innerHTML='';document.getElementById('messagesContainer').style.display='none';document.getElementById('welcomeScreen').style.display='flex'}
    await loadSessions();
  }catch(e){console.error(e)}
}

async function deleteAllSessions(){
  if(!confirm('Удалить ВСЕ сессии? Это действие необратимо.'))return;
  try{
    await fetch('/api/agent/sessions/clear',{method:'DELETE'});
    currentSession=null;
    document.getElementById('messagesContainer').innerHTML='';
    document.getElementById('messagesContainer').style.display='none';
    document.getElementById('welcomeScreen').style.display='flex';
    await loadSessions();
  }catch(e){console.error(e)}
}

async function createNewSession(){
  try{
    const r=await fetch('/api/agent/sessions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:currentMode,folder:selectedFolder,model:document.getElementById('modelSelect').value})});
    const d=await r.json();
    if(d.id){currentSession=d.id;document.getElementById('welcomeScreen').style.display='none';document.getElementById('messagesContainer').style.display='block';document.getElementById('messagesContainer').innerHTML='';addMsg('ai','Сессия создана. Опишите задачу. Я использую память, инструменты и могу создавать суб-агентов.');await loadSessions()}
  }catch(e){console.error(e)}
}

async function switchSession(id){
  currentSession=id;await loadSessions();
  try{
    const r=await fetch('/api/agent/sessions/'+id+'.json');
    const d=await r.json();
    document.getElementById('welcomeScreen').style.display='none';
    const mc=document.getElementById('messagesContainer');mc.style.display='block';mc.innerHTML='';
    (d.messages||[]).forEach(m=>addMsg(m.role==='user'?'user':'ai',m.content,m.action_steps,m.code_blocks,m.sub_agents));
  }catch(e){console.error(e)}

  // Load teams
  loadTeamsList();
}

// === TEAM MANAGEMENT IN CHAT ===
let availableTeams = [];
let attachedTeamId = null;

async function loadTeamsList() {
  try {
    const res = await fetch('/api/agent/teams/list');
    const data = await res.json();
    availableTeams = data.teams || [];

    const select = document.getElementById('teamSelect');
    select.innerHTML = availableTeams.map(t =>
      `<option value="${t.team_id}">${t.name} (${t.agent_count} agents)</option>`
    ).join('');
  } catch(e) {
    console.error('Load teams error:', e);
  }
}

function toggleTeamSelector() {
  const selector = document.getElementById('teamSelector');
  if (selector.style.display === 'none') {
    selector.style.display = 'block';
    loadTeamsList();
  } else {
    selector.style.display = 'none';
  }
}

async function attachSelectedTeam() {
  const teamId = document.getElementById('teamSelect').value;
  if (!teamId) {
    alert('Выберите команду');
    return;
  }
  if (!currentSession) {
    alert('Сначала создайте сессию');
    return;
  }

  try {
    const res = await fetch(`/api/agent/teams/${teamId}/attach`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ session_id: currentSession })
    });
    const result = await res.json();

    if (result.ok) {
      attachedTeamId = teamId;
      const team = availableTeams.find(t => t.team_id === teamId);
      const info = document.getElementById('attachedTeamInfo');
      info.style.display = 'block';
      info.innerHTML = `✅ Команда "<b>${team.name}</b>" (${team.agent_count} агентов) прикреплена к сессии`;
      document.getElementById('teamSelector').style.display = 'none';
      addMsg('ai', `👥 Команда "${team.name}" активирована!\n\nУчастники: ${team.agent_count} агентов\nСтратегия: ${team.strategy}\n\nАгент будет распределять задачи между членами команды.`);
    } else {
      alert('Ошибка: ' + (result.error || 'Неизвестная'));
    }
  } catch(e) {
    alert('Ошибка: ' + e.message);
  }
}

function detachTeam() {
  attachedTeamId = null;
  document.getElementById('attachedTeamInfo').style.display = 'none';
  document.getElementById('teamSelector').style.display = 'none';
  addMsg('ai', '👥 Команда отключена. Агент работает один.');
}

// Send
async function sendMsg(){
  const inp=document.getElementById('agentInput');
  const text=inp.value.trim();
  if(!text||processing)return;
  if(!currentSession)await createNewSession();
  if(!currentSession)return;

  processing=true;
  document.getElementById('sendBtn').disabled=true;
  document.getElementById('statusText').innerHTML='<span style="color:var(--orange)">● Думаю...</span>';
  showActionButtons();  // Show cancel/reason buttons

  addMsg('user',text);
  inp.value='';inp.style.height='auto';

  // Create streaming message element
  const mc=document.getElementById('messagesContainer');
  const aiDiv=document.createElement('div');
  aiDiv.className='msg ai';
  const loaderId='streamingLoader_'+Date.now();
  const streamId='streamingText_'+Date.now();
  aiDiv.innerHTML=`<div class="msg-bubble"><div class="label"><i class="fas fa-robot"></i> ASIO</div><div class="text" id="${streamId}"></div><div class="loading" id="${loaderId}"><div class="spinner"></div> Генерация...</div></div>`;
  mc.appendChild(aiDiv);
  mc.scrollTop=mc.scrollHeight;

  const streamEl=document.getElementById(streamId);
  const loaderEl=document.getElementById(loaderId);
  let fullAnswer='';

  try{
    const resp=await fetch('/api/agent/chat-stream',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        session:currentSession,
        message:text,
        mode:currentMode,
        folder:selectedFolder,
        model:document.getElementById('modelSelect').value,
        execMode:document.getElementById('execMode').value,
        maxIterations:getEffectiveMaxIterations(),
        askDb:askDbEnabled
      })
    });

    const reader=resp.body.getReader();
    const decoder=new TextDecoder();
    let buffer='';

    while(true){
      const {done,value}=await reader.read();
      if(done)break;
      buffer+=decoder.decode(value,{stream:true});
      const lines=buffer.split('\n');
      buffer=lines.pop()||'';

      for(const line of lines){
        if(!line.startsWith('data: '))continue;
        try{
          const d=JSON.parse(line.slice(6));
          if(d.done){
            fullAnswer=d.full_answer||fullAnswer;
            loaderEl.style.display='none';
            streamEl.removeAttribute('id');

            // Show reasoning iterations count
            if(d.reasoning_iterations){
              const rc=document.getElementById('reasoningCounter');
              if(rc)rc.textContent=`💡 ${d.reasoning_iterations} рассуждений`;
            }

            // Show action results
            if(d.action_results&&d.action_results.length){
              for(const ar of d.action_results){
                let actionHtml=`<div class="code-panel"><div class="header"><span class="lang">${ar.tool||ar.action||'?'}</span><span class="status ${ar.success?'success':'error'}">${ar.success?'✅ Успех':'❌ Ошибка'}</span></div>`;
                if(ar.output)actionHtml+=`<pre style="white-space:pre-wrap;font-size:11px">${esc(ar.output)}</pre>`;
                actionHtml+='</div>';
                aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',actionHtml);
              }
            }
            await loadSessions();
          }else if(d.delta){
            fullAnswer+=d.delta;
            streamEl.textContent=fullAnswer;
            mc.scrollTop=mc.scrollHeight;
          }
          // New events
          if(d.prompt_improved){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--green);padding:4px 8px;background:rgba(35,134,54,0.1);border-radius:6px;margin:4px 0">✨ Prompt Engineer улучшил промт</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.reasoning){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div class="reasoning-box" title="${esc(d.reasoning)}"><div class="header"><span class="title">💡 Рассуждение (наведи для просмотра)</span></div><div class="content" style="font-size:11px">${esc(d.reasoning.substring(0,300))}${d.reasoning.length>300?'...':''}</div></div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.graph_update){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--green);padding:4px 8px;background:rgba(35,134,54,0.1);border-radius:6px;margin:4px 0">${esc(d.graph_update)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.auto_retry){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--orange);padding:4px 8px">🔄 Авто-retry #${d.auto_retry}...</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.tool_start){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--accent);padding:4px 8px">🔧 [${esc(d.tool_start.tool)}] ${esc(d.tool_start.args)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.tool_result){
            const status=d.tool_result.success?'✅':'❌';
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;padding:4px 8px;background:var(--bg);border-radius:6px;margin:2px 0">${status} <b>${esc(d.tool_result.tool)}</b>: ${esc(String(d.tool_result.output).substring(0,300))}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.auto_fix){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--purple);padding:4px 8px">${esc(d.auto_fix)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.auto_skill_detect){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--orange);padding:4px 8px">${esc(d.auto_skill_detect)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.skill_created){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--green);padding:4px 8px;background:rgba(35,134,54,0.1);border-radius:6px;margin:2px 0">${esc(d.skill_created)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.skill_info){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--text2);padding:4px 8px">${esc(d.skill_info)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.subagent_start){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--purple);padding:6px 10px;background:linear-gradient(135deg,rgba(139,92,246,0.1),rgba(88,166,255,0.1));border:1px solid var(--purple);border-radius:8px;margin:4px 0">🐝 <b>Sub-Agent:</b> ${esc(d.subagent_start.role||'')} — ${esc(d.subagent_start.task||'').substring(0,100)}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.subagent_done){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--green);padding:4px 8px">✅ Sub-Agent завершил: ${esc(d.subagent_done.role||'')}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.dual_model){
            aiDiv.querySelector('.msg-bubble').insertAdjacentHTML('beforeend',`<div style="font-size:10px;color:var(--accent);padding:4px 8px">🔄 Dual Model: ${esc(d.dual_model.small||'')} + ${esc(d.dual_model.large||'')}</div>`);
            mc.scrollTop=mc.scrollHeight;
          }
          if(d.cancelled){
            loaderEl.style.display='none';
            streamEl.textContent=fullAnswer||'Задача отменена.';
            streamEl.removeAttribute('id');
          }
          if(d.error){
            loaderEl.style.display='none';
            streamEl.textContent='⚠️ '+d.error;
          }
        }catch(e){}
      }
    }
    // Гарантированно скрываем лоадер после завершения stream
    if(loaderEl) loaderEl.style.display='none';
    if(streamEl) streamEl.removeAttribute('id');
  }catch(e){
    if(loaderEl)loaderEl.style.display='none';
    if(streamEl){streamEl.textContent='⚠️ Ошибка: '+e.message;streamEl.removeAttribute('id')}
  }
  processing=false;
  document.getElementById('sendBtn').disabled=false;
  document.getElementById('statusText').innerHTML='● Готов';
  document.getElementById('actionButtons').style.display='none';
}

// === CANCEL & REASONING BUTTONS ===
async function cancelAgentTask(){
  if(!currentSession)return;
  if(!confirm('Отменить текущую задачу агента?'))return;

  try{
    const resp=await fetch('/api/agent/cancel',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({session:currentSession})
    });
    const data=await resp.json();
    if(data.ok){
      addMsg('ai','⛔ Задача отменена пользователем.');
      document.getElementById('statusText').innerHTML='<span style="color:var(--red)">● Отменено</span>';
    }
  }catch(e){
    alert('Ошибка отмены: '+e.message);
  }
}

async function triggerReasoning(){
  if(!currentSession)return;

  document.getElementById('statusText').innerHTML='<span style="color:var(--purple)">● Рассуждаю...</span>';
  const reasonBtn=document.getElementById('reasonBtn');
  reasonBtn.disabled=true;
  reasonBtn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Думаю...';

  try{
    const resp=await fetch('/api/agent/reason',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({session:currentSession})
    });
    const data=await resp.json();

    if(data.success){
      // Show reasoning in a special box
      const mc=document.getElementById('messagesContainer');
      const reasonDiv=document.createElement('div');
      reasonDiv.className='msg ai';
      reasonDiv.innerHTML=`<div class="reasoning-box">
        <div class="header"><span class="title">💡 Рассуждение агента</span><span style="font-size:10px;color:var(--text2)">${data.nodes_added||0} узлов в граф знаний</span></div>
        <div class="content">${formatText(data.reasoning)}</div>
      </div>`;
      mc.appendChild(reasonDiv);
      mc.scrollTop=mc.scrollHeight;
    }else{
      addMsg('ai','⚠️ Ошибка рассуждения: '+(data.error||'Неизвестная'));
    }
  }catch(e){
    addMsg('ai','⚠️ Ошибка: '+e.message);
  }

  reasonBtn.disabled=false;
  reasonBtn.innerHTML='<i class="fas fa-lightbulb"></i> Рассуждать';
  document.getElementById('statusText').innerHTML='● Готов';
}

// Show action buttons during processing
function showActionButtons(){
  document.getElementById('actionButtons').style.display='flex';
}

// Messages
function addMsg(type,text,steps,codeBlocks,subAgents){
  const mc=document.getElementById('messagesContainer');
  const div=document.createElement('div');
  div.className='msg '+type;
  const label=type==='user'?'<i class="fas fa-user"></i> Вы':'<i class="fas fa-robot"></i> ASIO';
  let html=`<div class="msg-bubble"><div class="label">${label}</div>`;

  // Action steps
  if(steps&&steps.length){
    html+='<div class="action-steps">';
    steps.forEach(s=>{
      const icons={analysis:'🔍',plan:'📋',memory:'🧠',code:'💻',exec:'▶️',error:'❌',result:'✅',spawn:'🐝',tool:'🔧'};
      html+=`<div class="action-step"><div class="step-icon ${s.type}">${icons[s.type]||'•'}</div><div class="step-content"><div class="step-title">${esc(s.title)}</div><div class="step-text">${esc(s.text)}</div></div></div>`;
    });
    html+='</div>';
  }

  // Text
  if(text)html+=`<div class="text">${formatText(text)}</div>`;

  // Sub-agents
  if(subAgents&&subAgents.length){
    html+='<div style="margin-top:8px">';
    subAgents.forEach(sa=>{html+=`<div class="subagent-badge">🐝 ${esc(sa.role)}</div><div style="font-size:12px;color:var(--text2);margin-bottom:8px">${esc(sa.result||'')}</div>`});
    html+='</div>';
  }

  // Code blocks
  if(codeBlocks&&codeBlocks.length){
    codeBlocks.forEach((cb,i)=>{
      html+=`<div class="code-panel" data-cb-idx="${i}"><div class="header"><span class="lang">${esc(cb.lang||'python')}</span><span class="status ${cb.status||'pending'}">${cb.status==='executed'?'✅ Выполнен':cb.status==='error'?'❌ Ошибка':cb.status==='advisory'?'🟡 Ожидание':'⏳ Ожидание'}</span></div>`;
      html+=`<pre><code>${esc(cb.code)}</code><button class="copy-btn" onclick="copyCode(this)"><i class="fas fa-copy"></i></button></pre>`;
      if(cb.output!==undefined&&cb.output!==null)html+=`<div class="output">${esc(cb.output)}</div>`;
      if(cb.status==='advisory'){
        html+=`<div class="actions"><button class="execute" onclick="executeCode('${currentSession}',${i})"><i class="fas fa-play"></i> Выполнить</button><button class="skip" onclick="skipCode('${currentSession}',${i})"><i class="fas fa-forward"></i> Пропустить</button></div>`;
      }
      html+=`</div>`;
    });
  }

  html+='</div>';
  div.innerHTML=html;mc.appendChild(div);mc.scrollTop=mc.scrollHeight;
}

